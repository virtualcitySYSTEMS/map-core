{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",

    /* Additional Checks */
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": false,

    /* Module Resolution Options */
    "paths": {
      "rbush-knn": ["./types/rbush-knn"],
      "rbush": ["./types/rbush"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "types": ["node"]
  },
  "exclude": ["dist/", "build/", "tests/"],
  "include": ["types/", "src/", "index.ts"]
}
