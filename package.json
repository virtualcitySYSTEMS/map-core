{
  "name": "@vcmap/core",
  "version": "7.0.0-rc.2",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "pretest": "tsc -b && node -e \"require('fs').cpSync('tests/data', 'dist/tests/data', { recursive: true })\"",
    "test": "mocha --exit --enable-source-maps --require dist/tests/setup.js --require dist/tests/vcs.js \"dist/tests/**/*.spec.js\"",
    "lint:js": "eslint . --ext .vue,.js,.cjs,.mjs,.ts",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "format": "prettier --write --list-different . && npm run lint:js -- --fix",
    "type-check": "tsc -b",
    "postinstall": "node build/buildShader.js",
    "coverage": "c8 --reporter text-summary npm run test",
    "coverage:gitlab": "c8 --reporter text-summary npm run test -- --reporter mocha-junit-reporter",
    "build-docs": "typedoc index.ts --out docs --skipErrorChecking",
    "build-shader": "node build/buildShader.js",
    "prebuild": "node build/buildShader.js",
    "build": "tsc -b && node -e \"require('fs').cpSync('tests/data', 'dist/tests/data', { recursive: true })\"",
    "watch": "node build/watch.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/virtualcitySYSTEMS/map-core.git"
  },
  "files": [
    "build/buildShader.js",
    "src/",
    "index.ts",
    "dist/*.*",
    "dist/src/",
    "dist/tests/data/",
    "dist/tests/unit/helpers/",
    "!dist/**/*.tsbuildinfo",
    "!dist/tests/**/*.spec.*",
    "!**/*.shader.ts"
  ],
  "author": "Virtual City Systems",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^4.0.0",
    "@vcsuite/eslint-config": "^4.1.0",
    "c8": "^12.0.0",
    "canvas": "^3.2.3",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "resize-observer-polyfill": "^1.5.1",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@vcmap-cesium/engine": "^26.0.1",
    "ol": "^10.10.0"
  },
  "prettier": "@vcsuite/eslint-config/prettier.js",
  "dependencies": {
    "@vcsuite/check": "^3.2.2",
    "@vcsuite/logger": "^1.0.1",
    "@vcsuite/parsers": "^2.0.1",
    "fast-deep-equal": "^3.1.3",
    "flatgeobuf": "^4.4.0",
    "geotiff": "^3.1.0-beta.0",
    "ol-mapbox-style": "^13.4.2",
    "proj4": "^2.21.0",
    "rbush": "^4.0.1",
    "rbush-knn": "^4.0.0",
    "uuid": "^14.0.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
